{
  "name": "dayflow-hrms-backend",
  "version": "1.0.0",
  "description": "Dayflow - Human Resource Management System Backend with Node.js, Express, and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "db:setup": "node src/scripts/migrate.js && node src/scripts/seed.js",
    "db:reset": "node src/scripts/reset.js",
    "test:api": "node src/scripts/testApi.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "tar": "^7.5.3"
  },
  "keywords": [
    "hrms",
    "dayflow",
    "postgresql",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC"
}

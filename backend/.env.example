# ============================================================================
# Dayflow HRMS Backend - Environment Variables Template
# Copy this file to .env and configure your local or production credentials.
# DO NOT commit real secrets or credentials to Git.
# ============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Option A: Single Cloud Connection String (e.g. Neon, Render, Railway, Vercel)
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-12345.us-east-2.aws.neon.tech/dayflow?sslmode=require

# ----------------------------------------------------------------------------
# Option B: Individual PostgreSQL Parameters (Local Development)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dayflow
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_SSL=false
DB_MAX_CONNECTIONS=20

# ----------------------------------------------------------------------------
# Authentication & JWT Configuration
# ----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_production_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# CORS Configuration (Allowed Frontend Origins)
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173
